# ============================================================
#  YEPPER — PRODUCTION ENVIRONMENT
#
#  TWO Render services:
#    Frontend  → https://yepper-creators.onrender.com   (Next.js)
#    Backend   → https://yepper-backend.onrender.com    ← Render assigns
#                this URL when you create the backend service; update below
# ============================================================


# ────────────────────────────────────────────────────────────
#  SERVICE 1: FRONTEND  (yepper-creators.onrender.com)
#  Render settings:
#    Build command : npm install; npm run build
#    Start command : npm start
# ────────────────────────────────────────────────────────────

NODE_ENV=production

# Point all API calls at the backend service URL
NEXT_PUBLIC_API_URL=https://yepper-backend.onrender.com
NEXT_PUBLIC_ADSENSE_API_URL=https://yepper-backend.onrender.com
ADSENSE_BACKEND_URL=https://yepper-backend.onrender.com

# Google OAuth (used by Next.js /api/auth/google route)
# Authorized redirect URI to add in Google Console:
#   https://yepper-creators.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Database (only if any Next.js route queries DB directly)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE


# ────────────────────────────────────────────────────────────
#  SERVICE 2: BACKEND  (yepper-backend.onrender.com)
#  Render settings:
#    Root directory : backend
#    Build command  : npm install
#    Start command  : node server.js
# ────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5000

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# Secrets
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-another-long-random-secret
TRACKING_HASH_SALT=replace-with-a-random-salt

# Service URLs — backend knows its own URL + frontend URL
BACKEND_URL=https://yepper-backend.onrender.com
FRONTEND_URL=https://yepper-creators.onrender.com
FRONTEND_ORIGIN=https://yepper-creators.onrender.com
THIRD_PARTY_WEBSITE_URL=https://yepper-creators.onrender.com/adsense
WAITLIST_FRONTEND_URL=https://yepper-creators.onrender.com
BRAND_LOGO_URL=https://yepper-creators.onrender.com/logo.png

# Google OAuth (Passport.js sign-in + creator login)
# Authorized redirect URIs to add in Google Console:
#   https://yepper-backend.onrender.com/api/auth/google/callback
#   https://yepper-backend.onrender.com/auth/creator/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# YouTube OAuth
# Authorized redirect URI:
#   https://yepper-backend.onrender.com/api/connect/youtube/callback
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=your_email@gmail.com

# Flutterwave (uncomment when ready)
# FLUTTERWAVE_TEST_MODE=false
# FLW_TEST_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# FLW_SECRET_HASH=your_flutterwave_webhook_hash
# NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Cloudinary (uncomment when ready)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# AI / Search (uncomment when ready)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
# BING_SEARCH_API_KEY=
# SERPAPI_KEY=

# Admin panel
ADMIN_NAME=admin
ADMIN_SECRET=replace-with-strong-secret


# ────────────────────────────────────────────────────────────
#  GOOGLE CONSOLE — ALL REDIRECT URIs TO ADD
#  console.cloud.google.com → Credentials → your OAuth Client
# ────────────────────────────────────────────────────────────
#
#  Authorized redirect URIs:
#    https://yepper-backend.onrender.com/api/auth/google/callback
#    https://yepper-backend.onrender.com/auth/creator/google/callback
#    https://yepper-backend.onrender.com/api/connect/youtube/callback
#    https://yepper-creators.onrender.com/api/auth/google/callback
#
#  Authorized JavaScript origins:
#    https://yepper-creators.onrender.com
#    https://yepper-backend.onrender.com
