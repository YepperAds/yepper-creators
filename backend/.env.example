# Copy to .env and fill in real values. Never commit .env itself.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Auth secrets ────────────────────────────────────────────────────────────
JWT_SECRET=
SESSION_SECRET=

# ── Admin panel auth (x-node-key / x-node-ref headers) ─────────────────────
ADMIN_SECRET=
ADMIN_NAME=

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── URLs — set these to the deployed URLs in production. Code falls back to
#    localhost when unset, which is intentional for local dev; don't remove
#    those fallbacks in source, just set these here/in your host's dashboard. ──
BACKEND_URL=https://yepper-creators-api.onrender.com
FRONTEND_URL=https://yepper-creators.vercel.app
FRONTEND_ORIGIN=https://yepper-creators.vercel.app
WAITLIST_FRONTEND_URL=https://yepper-creators.vercel.app
