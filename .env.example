# Copy to .env.local and fill in real values for local dev. Never commit your
# actual .env/.env.local.
#
# In production (Vercel), set these in the project's Environment Variables
# dashboard to the deployed backend URL. The code falls back to
# http://localhost:5000 when these are unset — that fallback is intentional
# for local dev and should stay in source; just make sure these are actually
# set in the Vercel dashboard for production.

ADSENSE_BACKEND_URL=https://yepper-creators-api.onrender.com
NEXT_PUBLIC_API_URL=https://yepper-creators-api.onrender.com
NEXT_PUBLIC_ADSENSE_API_URL=https://yepper-creators-api.onrender.com
