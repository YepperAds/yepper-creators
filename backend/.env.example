# Copy to .env and fill in real values. Never commit .env itself.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Auth secrets ────────────────────────────────────────────────────────────
JWT_SECRET=
SESSION_SECRET=

# ── Admin panel auth (x-node-key / x-node-ref headers) ─────────────────────
ADMIN_SECRET=
ADMIN_NAME=

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── URLs — set these to the deployed URLs in production. Code falls back to
#    localhost when unset, which is intentional for local dev; don't remove
#    those fallbacks in source, just set these here/in your host's dashboard. ──
BACKEND_URL=https://yepper-creators-api.onrender.com
FRONTEND_URL=https://yepper.cc
FRONTEND_ORIGIN=https://yepper.cc
WAITLIST_FRONTEND_URL=https://yepper.cc

# ── Video rendering worker ──────────────────────────────────────────────────
# Deploy backend/creators/workerServer.js as a separate Render web service
# (root: backend, build: npm ci, start: npm run worker; share DATABASE_URL and
# JWT_SECRET with the API; set NODE_ENV=production). Set this URL in Vercel as
# NEXT_PUBLIC_AD_VIDEO_API_URL so video job requests do not compete with the main API.
# NEXT_PUBLIC_AD_VIDEO_API_URL=https://your-video-worker.onrender.com

# Dedicated Cloudinary account used only for video assets and rendering.
# Keep the API secret on the backend/Render service, never in Vercel NEXT_PUBLIC_* vars.
VID_CLOUDINARY_NAME=
VID_CLOUDINARY_KEY=
VID_CLOUDINARY_API_SECRET=
