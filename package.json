    "axios": "^1.5.0",
    "express-session": "^1.19.0",
    "framer-motion": "^12.23.6",
    "lucide-react": "^1.8.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "nodemon": "^3.1.14",
    "pg": "^8.11.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.45.4",
    "react-hot-toast": "^2.4.1",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
