# Copy to .env.local and fill in real values for local dev. Never commit your
# actual .env/.env.local.
#
# In production (Vercel), set these in the project's Environment Variables
# dashboard to the deployed backend URL. The general API variables fall back
# to localhost for local development. Video uploads default to the dedicated
# production worker below, but set that URL explicitly in Vercel.

ADSENSE_BACKEND_URL=https://yepper-creators-api.onrender.com
NEXT_PUBLIC_API_URL=https://yepper-creators-api.onrender.com
NEXT_PUBLIC_ADSENSE_API_URL=https://yepper-creators-api.onrender.com
# Long-video and creator video-upload requests use the dedicated worker.
NEXT_PUBLIC_AD_VIDEO_API_URL=https://yepper-creators-video-worker.onrender.com
NEXT_PUBLIC_MAX_LONG_VIDEO_MINUTES=150
# Set to true only while recording the Google OAuth verification demo.
NEXT_PUBLIC_YOUTUBE_OAUTH_DEMO=false
