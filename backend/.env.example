# Copy to .env and fill in real values. Never commit .env itself.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Auth secrets ────────────────────────────────────────────────────────────
JWT_SECRET=
SESSION_SECRET=

# ── Admin panel auth (x-node-key / x-node-ref headers) ─────────────────────
ADMIN_SECRET=
ADMIN_NAME=

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── URLs — set these to the deployed URLs in production. Code falls back to
#    localhost when unset, which is intentional for local dev; don't remove
#    those fallbacks in source, just set these here/in your host's dashboard. ──
BACKEND_URL=https://yepper-creators-api.onrender.com
FRONTEND_URL=https://yepper.cc
FRONTEND_ORIGIN=https://yepper.cc
WAITLIST_FRONTEND_URL=https://yepper.cc

# ── Video rendering worker ──────────────────────────────────────────────────
# Deploy backend/creators/workerServer.js as a separate Render web service
# (root: backend, build: npm ci, start: npm run worker; share DATABASE_URL and
# JWT_SECRET with the API; set NODE_ENV=production). Set this URL in Vercel as
# NEXT_PUBLIC_AD_VIDEO_API_URL so video job requests do not compete with the main API.
# NEXT_PUBLIC_AD_VIDEO_API_URL=https://your-video-worker.onrender.com
# Explicit browser origins accepted by the worker, comma-separated.
CORS_ALLOWED_ORIGINS=https://yepper.cc,https://www.yepper.cc

# Dedicated Cloudinary account used only for video assets and rendering.
# Keep the API secret on the backend/Render service, never in Vercel NEXT_PUBLIC_* vars.
VID_CLOUDINARY_NAME=
VID_CLOUDINARY_KEY=
VID_CLOUDINARY_API_SECRET=

# Long video uploads use direct S3 multipart upload and AWS MediaConvert.
# The AWS credentials are used only by the backend/Render worker. Its IAM
# identity needs S3 multipart/object read-write access and MediaConvert
# DescribeEndpoints/CreateJob/GetJob permissions. The MediaConvert service role
# must trust mediaconvert.amazonaws.com and read inputs/overlays and write
# outputs in the configured bucket.
AWS_REGION=
AWS_S3_VIDEO_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_MEDIACONVERT_ROLE_ARN=
# Optional; MediaConvert discovers the regional endpoint when this is unset.
AWS_MEDIACONVERT_ENDPOINT=
MAX_AWS_AD_VIDEO_SIZE_GB=100
# Long-video budget model. Set the current per-minute processing estimate and
# USD/RWF rate in the worker environment; there is intentionally no guessed
# service price or exchange-rate fallback.
PROCESSING_BUDGET_PERCENT_OF_COMMISSION=10
PROCESSING_COST_PER_MIN_USD=
USD_RWF_RATE=

# Configure this CORS rule on AWS_S3_VIDEO_BUCKET so the browser can upload
# parts and read their ETags:
# [
#   {
#     "AllowedOrigins": ["https://yepper.cc", "https://www.yepper.cc"],
#     "AllowedMethods": ["PUT", "GET", "HEAD"],
#     "AllowedHeaders": ["*"],
#     "ExposeHeaders": ["ETag"],
#     "MaxAgeSeconds": 3000
#   }
# ]
# Add S3 lifecycle rules to abort incomplete multipart uploads after 1 day,
# expire the yepper/ad-video-inputs/ and yepper/ad-video-overlays/ prefixes
# after 1 day, and expire yepper/ad-video-outputs/ after a suitable download
# retention period (for example, 30 days).
